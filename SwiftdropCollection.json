{
  "info": {
    "name": "SwiftDrop API",
    "description": "Courier & Logistics Management Platform — full API collection covering Auth, Users, Parcels, Deliveries, Payments, and Admin modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "swiftdrop-api-collection"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shiftdrop-platform-backend.vercel.app/api/v1",
      "type": "string"
    },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "parcelId", "value": "", "type": "string" },
    { "key": "agentUserId", "value": "", "type": "string" },
    { "key": "googleIdToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"SwiftDrop API is healthy\",\n  \"data\": {\n    \"uptime\": 12.34,\n    \"timestamp\": \"2026-09-03T10:00:00.000Z\",\n    \"environment\": \"development\",\n    \"database\": \"connected\",\n    \"redis\": \"connected\",\n    \"redisTtlSample\": 30\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\",\n  \"phone\": \"01700000000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. Role must be CUSTOMER or DELIVERY_AGENT — ADMIN accounts are seed-only."
          },
          "response": [
            {
              "name": "201 Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOi...\",\n    \"refreshToken\": \"eyJhbGciOi...\"\n  }\n}"
            },
            {
              "name": "409 Conflict — Email already exists",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"message\": \"Email is already registered\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOi...\",\n    \"refreshToken\": \"eyJhbGciOi...\"\n  }\n}"
            },
            {
              "name": "401 Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid email or password\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Google Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            },
            "description": "idToken must be obtained from Google Identity Services on the client side. New sign-ups default to role CUSTOMER."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Google login successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOi...\",\n    \"refreshToken\": \"eyJhbGciOi...\"\n  }\n}"
            },
            {
              "name": "401 Unauthorized — Invalid token",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid Google token\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Old refresh token is revoked on use (rotation) and a new pair is issued."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Token refreshed successfully\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOi...\",\n    \"refreshToken\": \"eyJhbGciOi...\"\n  }\n}"
            },
            {
              "name": "401 Unauthorized — Expired/revoked",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Refresh token is no longer valid\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Logout successful\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          },
          "response": [
            {
              "name": "200 OK — Customer",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Profile retrieved successfully\",\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"01700000000\",\n    \"role\": \"CUSTOMER\",\n    \"provider\": \"LOCAL\",\n    \"status\": \"ACTIVE\",\n    \"createdAt\": \"2026-09-01T00:00:00.000Z\",\n    \"customer\": { \"defaultPickupAddress\": \"123 Main St, Dhaka\" },\n    \"deliveryAgent\": null\n  }\n}"
            },
            {
              "name": "401 Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Authentication token is missing\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"phone\": \"01711111111\",\n  \"defaultPickupAddress\": \"123 Main St, Dhaka\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Customer-only fields (defaultPickupAddress) and agent-only fields (vehicleType, licenseNumber, availability) are silently ignored if sent by the wrong role."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Profile updated successfully\",\n  \"data\": { \"id\": \"uuid\", \"name\": \"John Updated\" }\n}"
            },
            {
              "name": "422 Validation Error — Empty body",
              "code": 422,
              "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed\",\n  \"errors\": [\n    { \"field\": \"body\", \"message\": \"At least one field must be provided to update\" }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Update My Profile (Delivery Agent)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleType\": \"Motorcycle\",\n  \"licenseNumber\": \"DHK-1234\",\n  \"availability\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Profile updated successfully\",\n  \"data\": {\n    \"role\": \"DELIVERY_AGENT\",\n    \"deliveryAgent\": {\n      \"vehicleType\": \"Motorcycle\",\n      \"licenseNumber\": \"DHK-1234\",\n      \"availability\": \"AVAILABLE\"\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Parcels",
      "item": [
        {
          "name": "Create Shipment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderName\": \"John Doe\",\n  \"senderPhone\": \"01700000000\",\n  \"receiverName\": \"Jane Smith\",\n  \"receiverPhone\": \"01800000000\",\n  \"pickupAddress\": \"House 12, Road 5\",\n  \"pickupCity\": \"Dhaka\",\n  \"deliveryAddress\": \"House 8, Road 2\",\n  \"deliveryCity\": \"Bogra\",\n  \"parcelType\": \"PACKAGE\",\n  \"weightKg\": 2.5,\n  \"serviceType\": \"EXPRESS\",\n  \"notes\": \"Handle with care\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/parcels",
              "host": ["{{baseUrl}}"],
              "path": ["parcels"]
            },
            "description": "CUSTOMER only. deliveryCharge is calculated server-side from weight, service type, and pickup/delivery city zone — never trust a client-supplied price."
          },
          "response": [
            {
              "name": "201 Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Shipment created successfully\",\n  \"data\": {\n    \"id\": \"uuid\",\n    \"trackingId\": \"SD260902A1B2C3\",\n    \"status\": \"PENDING\",\n    \"deliveryCharge\": 180,\n    \"customerId\": \"uuid\"\n  }\n}"
            },
            {
              "name": "403 Forbidden — Wrong role",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"message\": \"You do not have permission to perform this action\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "List Shipments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/parcels?page=1&limit=10&status=IN_TRANSIT&sortBy=createdAt&sortOrder=desc&q=SD2609",
              "host": ["{{baseUrl}}"],
              "path": ["parcels"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                {
                  "key": "status",
                  "value": "IN_TRANSIT",
                  "description": "optional — filter by ParcelStatus"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "optional — createdAt | deliveryCharge"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "optional — asc | desc"
                },
                {
                  "key": "q",
                  "value": "SD2609",
                  "description": "optional — search trackingId, receiverName, senderName"
                }
              ]
            },
            "description": "Scoped by role: CUSTOMER sees only their own, DELIVERY_AGENT sees only assigned, ADMIN sees all."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Shipments retrieved successfully\",\n  \"data\": [ { \"id\": \"uuid\", \"trackingId\": \"SD260902A1B2C3\", \"status\": \"IN_TRANSIT\" } ],\n  \"meta\": { \"page\": 1, \"limit\": 10, \"total\": 1, \"totalPages\": 1 }\n}"
            }
          ]
        },
        {
          "name": "Get Shipment By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/parcels/{{parcelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["parcels", "{{parcelId}}"]
            },
            "description": "Includes full statusHistory. Ownership is enforced — a customer cannot fetch another customer's parcel by guessing the ID."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Shipment retrieved successfully\",\n  \"data\": {\n    \"id\": \"uuid\",\n    \"trackingId\": \"SD260902A1B2C3\",\n    \"status\": \"IN_TRANSIT\",\n    \"statusHistory\": [\n      { \"status\": \"PENDING\", \"note\": \"Shipment created\", \"createdAt\": \"2026-09-01T00:00:00.000Z\" }\n    ]\n  }\n}"
            },
            {
              "name": "403 Forbidden — Not your shipment",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"message\": \"You do not have access to this shipment\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Cancel Shipment",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/parcels/{{parcelId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["parcels", "{{parcelId}}", "cancel"]
            },
            "description": "CUSTOMER only. Only allowed while status is PENDING or CONFIRMED."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Shipment cancelled successfully\",\n  \"data\": { \"status\": \"CANCELLED\" }\n}"
            },
            {
              "name": "409 Conflict — Not cancellable",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"message\": \"Cannot cancel a shipment that is already PICKED_UP\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Update Shipment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"note\": \"Left the sorting facility\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/parcels/{{parcelId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["parcels", "{{parcelId}}", "status"]
            },
            "description": "DELIVERY_AGENT (must be assigned agent) or ADMIN only. Validated against the shipment state machine — invalid transitions (e.g. skipping steps) are rejected with 409."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Shipment status updated to IN_TRANSIT\",\n  \"data\": { \"status\": \"IN_TRANSIT\" }\n}"
            },
            {
              "name": "409 Conflict — Invalid transition",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"message\": \"Cannot transition from IN_TRANSIT to DELIVERED\",\n  \"errors\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        {
          "name": "Assign Delivery Agent",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"{{agentUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/deliveries/{{parcelId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "{{parcelId}}", "assign"]
            },
            "description": "ADMIN only. agentId is the delivery agent's USER id (not the internal DeliveryAgent record id). Agent must be ACTIVE and AVAILABLE; parcel must be PENDING or CONFIRMED. Race-condition safe via atomic updateMany claims inside a transaction."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Delivery agent assigned successfully\",\n  \"data\": { \"status\": \"ASSIGNED\", \"assignedAgentId\": \"uuid\" }\n}"
            },
            {
              "name": "409 Conflict — Agent unavailable",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"message\": \"Delivery agent is not currently available\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Accept Assignment",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries/{{parcelId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "{{parcelId}}", "accept"]
            },
            "description": "DELIVERY_AGENT only — must be the assigned agent."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Assignment accepted\",\n  \"data\": { \"status\": \"ASSIGNED\" }\n}"
            }
          ]
        },
        {
          "name": "Reject Assignment",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries/{{parcelId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "{{parcelId}}", "reject"]
            },
            "description": "DELIVERY_AGENT only. Parcel reverts to CONFIRMED and agent reverts to AVAILABLE, so admin can reassign."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Assignment rejected\",\n  \"data\": { \"status\": \"CONFIRMED\", \"assignedAgentId\": null }\n}"
            }
          ]
        },
        {
          "name": "Mark Picked Up",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries/{{parcelId}}/pickup",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "{{parcelId}}", "pickup"]
            },
            "description": "DELIVERY_AGENT only — must be the assigned agent. Parcel must currently be ASSIGNED."
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Parcel marked as picked up\",\n  \"data\": { \"status\": \"PICKED_UP\" }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{parcelId}}/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{parcelId}}", "checkout"]
            },
            "description": "CUSTOMER only. Returns a Stripe-hosted checkoutUrl. Payment status becomes PAID only via the verified Stripe webhook — never via a client call."
          },
          "response": [
            {
              "name": "201 Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Checkout session created\",\n  \"data\": {\n    \"checkoutUrl\": \"https://checkout.stripe.com/c/pay/cs_test_...\",\n    \"paymentId\": \"uuid\"\n  }\n}"
            },
            {
              "name": "409 Conflict — Already paid",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"message\": \"This shipment has already been paid for\",\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Get Payment By Parcel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{parcelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{parcelId}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Payment details retrieved\",\n  \"data\": { \"status\": \"PAID\", \"amount\": 180, \"currency\": \"usd\" }\n}"
            }
          ]
        },
        {
          "name": "My Payment History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Payment history retrieved\",\n  \"data\": [ { \"status\": \"PAID\", \"amount\": 180 } ],\n  \"meta\": { \"page\": 1, \"limit\": 10, \"total\": 1, \"totalPages\": 1 }\n}"
            }
          ]
        },
        {
          "name": "Stripe Webhook (Stripe-triggered only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "stripe-signature",
                "value": "t=...,v1=...",
                "description": "Auto-generated by Stripe / Stripe CLI. Do not call this manually — signature verification will fail."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_...\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": { \"object\": { \"id\": \"cs_test_...\" } }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "webhook"]
            },
            "description": "Not meant to be called from Postman directly — included for documentation completeness. Test via `stripe listen --forward-to localhost:5000/api/v1/payments/webhook` and a real test-mode checkout instead."
          },
          "response": [
            { "name": "200 OK", "code": 200, "body": "{ \"received\": true }" },
            {
              "name": "400 Bad Request — Bad signature",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Webhook signature verification failed\",\n  \"errors\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
