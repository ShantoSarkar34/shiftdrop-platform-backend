model AuditLog {
    id String @id @default(uuid())

    actorId    String?
    action     String
    entityType String
    entityId   String

    metadata Json?

    createdAt DateTime @default(now())

    @@index([entityType, entityId])
    @@index([actorId])
    @@index([action])
    @@map("audit_logs")
}
